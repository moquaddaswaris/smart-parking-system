[Unit]
Description=VisionPark CCTV Parking Occupancy Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/parking-system/backend
ExecStart=/home/pi/parking-system/backend/venv/bin/python run.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

